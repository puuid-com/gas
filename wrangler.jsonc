{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gas",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    { "pattern": "gas.odeschenes.dev", "custom_domain": true },
    { "pattern": "gas.puuid.com", "custom_domain": true },
  ],
  // Price history: one snapshot of the Régie feed twice a day (UTC; 6 AM and
  // 6 PM in Quebec winter time, 7 AM and 7 PM in summer).
  "triggers": { "crons": ["0 11,23 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gas-history",
      "database_id": "36e77bdc-da64-4f74-85b3-a9a9adba5941",
      "migrations_dir": "migrations",
    },
  ],
}
